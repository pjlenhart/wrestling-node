# Copy to .env and fill in. The real .env is gitignored and never committed.
#
# Which database to talk to. Only 'prod' (or 'production') selects production:
# anything else -- a typo, an empty value, a missing variable, a fresh clone
# with no .env at all -- resolves to the local database.
#
#   PRODUCTION DEPLOYMENTS MUST SET THIS TO prod.
#
# Without it the server starts, logs a warning, and points at localhost, where
# every query fails. That is deliberate: a machine that cannot reach a database
# is recoverable, while one silently writing to production is not.
DB_SOURCE=local

# Production credentials. Used only when DB_SOURCE=prod.
DB_HOST=
DB_DATABASE=wrestlingdb
DB_USER=
DB_PASS=

# Local development credentials. Used for every other value of DB_SOURCE.
DB_LOCAL_HOST=localhost
DB_LOCAL_DATABASE=wrestlingdb
DB_LOCAL_USER=root
DB_LOCAL_PASS=

# Signs the tokens that authorise writing a scoresheet. At least 32 characters,
# and different in every environment. There is deliberately no fallback: a
# default would let anyone who has read this file forge a staff token.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Without it the API still serves every public read endpoint; only signing in
# fails, with a 503.
JWT_SECRET=

# Optional. Defaults to 8001.
# PORT=8001
